# Standalone development server only. The Mac app manages its own private configuration.
# Sanitized example: no real tokens, personal paths, hostnames or coordinates.
# npm run setup generates a private token in .env.
FRAME_TOKEN=replace-with-a-random-token-at-least-32-characters
HOST=127.0.0.1
PORT=8797
PUBLIC_ORIGIN=http://127.0.0.1:8797
FRAME_NAME=Our home
# Optional: match the folder chosen in the Mac app's Settings.
# APPLE_EXPORT_DIR=/absolute/path/to/your/private/frame-folder
# Weather, units, and timezone are configured in the Mac app.

# Optional: use a different build of the browser frame.
# FRAME_WEB_DIR=../frame-web/dist
